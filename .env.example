# DigitalOcean API token (needs billing:read; add account:read for the team name)
DIGITALOCEAN_TOKEN=
ACCOUNT_LABEL=DigitalOcean

# Schedule (cron syntax) — default every Monday 09:00
CRON_SCHEDULE=0 9 * * 1
REPORT_TIMEZONE=UTC
RUN_ON_START=false

# Optional: monthly budget in USD for budget alerts
MONTHLY_BUDGET=
ATTACH_INVOICE_PDF=true
ATTACH_CSV=true
HISTORY_FILE=./data/history.json
OUT_DIR=./out

# Resend (https://resend.com/api-keys) — MAIL_FROM must use a domain verified in Resend
RESEND_API_KEY=

# Mail (comma-separated lists)
MAIL_FROM=
MAIL_TO=
MAIL_CC=
MAIL_BCC=
MAIL_REPLY_TO=
MAIL_SUBJECT_PREFIX=[DO Billing]
SEND_SEPARATELY=false
ALERT_ON_FAILURE=true
